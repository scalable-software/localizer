{
  "mcpServers": {
    "ms365": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@softeria/ms-365-mcp-server",
        "--org-mode"
      ]
    },
    "wallaby": {
      "command": "cmd",
      "args": [
        "/c",
        "node",
        "%USERPROFILE%\\.wallaby\\mcp"
      ]
    },
    "chrome-devtools": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    }
  }
}
